{
  "name": "sf2026-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Landing Page institucional e de conversão — Sustainable Finance 2026 (Goiânia, 04/09/2026)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker-compose up -d --build",
    "infra:down": "docker-compose down",
    "test": "vitest run --coverage",
    "sonar": "bash sonar/start.sh",
    "sonar:down": "docker compose -f sonar/docker-compose.yml down -v && docker volume rm -f sonar_sonar_db sonar_sonarqube_data sonar_sonarqube_extensions sonar_sonarqube_logs 2>/dev/null; true"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.6.25",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.474.0",
    "next": "^15.5.19",
    "next-intl": "^4.13.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
